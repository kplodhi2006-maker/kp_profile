<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Education | Krishnapal Rajpoot</title>

    <link rel="stylesheet" href="/css/eduction.css">
</head>

<body>

    <section class="education-section">

        <!-- Heading -->
        <div class="education-heading">

            <p class="small-heading">MY ACADEMIC JOURNEY</p>

            <h1>
                My <span>Education</span>
            </h1>

            <p class="heading-description">
                My educational journey and academic achievements.
            </p>

        </div>


        <!-- Education Cards -->
        <div class="education-container">


            <!-- B.Tech -->
            <div class="education-card">

                <div class="card-number">
                    01
                </div>

                <div class="card-content">

                    <span class="education-status">
                        CURRENTLY PURSUING
                    </span>

                    <h2>
                        B.Tech in Computer Science & Engineering
                    </h2>

                    <h3>
                        Prestige Institute of Management and Research
                    </h3>

                    <p class="location">
                        📍 Bhopal, Madhya Pradesh
                    </p>

                    <p class="description">
                        Currently pursuing my Bachelor of Technology in
                        Computer Science and Engineering and developing my
                        knowledge in programming, software development and
                        computer science concepts.
                    </p>

                </div>

            </div>


            <!-- Class 12 -->
            <div class="education-card">

                <div class="card-number">
                    02
                </div>

                <div class="card-content">

                    <span class="education-status">
                        CLASS 12
                    </span>

                    <h2>
                        Higher Secondary Education
                    </h2>

                    <h3>
                        Model School, Chanderi
                    </h3>

                    <p class="location">
                        📍 Chanderi, District Ashoknagar, M.P.
                    </p>

                    <p class="description">
                        Completed my Class 12 education from Model School,
                        Chanderi with a strong academic foundation.
                    </p>

                    <div class="percentage">
                        73%
                    </div>

                </div>

            </div>


            <!-- Class 10 -->
            <div class="education-card">

                <div class="card-number">
                    03
                </div>

                <div class="card-content">

                    <span class="education-status">
                        CLASS 10
                    </span>

                    <h2>
                        Secondary Education
                    </h2>

                    <h3>
                        Model School, Chanderi
                    </h3>

                    <p class="location">
                        📍 Chanderi, District Ashoknagar, M.P.
                    </p>

                    <p class="description">
                        Completed my Class 10 education from Model School,
                        Chanderi with an academic score of 80%.
                    </p>

                    <div class="percentage">
                        80%
                    </div>

                </div>

            </div>


        </div>

    </section>

</body>

</html>